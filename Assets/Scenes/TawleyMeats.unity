  m_text: "$doorController = get[system.hardware.doorlocks];\r\n\r\nmain action OperateDoors[Event
    $OnClickEvent]:\r\n\r\n\tcase: [$OnClickEvent is $PowerRoomButton.clicked()]:\r\n\t//Door
    lock is broken, do nothing.\r\n\t\r\n\tcase: [$OnClickEvent is $Processing1Button.clicked()]:\r\n\t//
    Door is missing, do nothing.\r\n\t\r\n\tcase: [$OnClickEvent is $Processing2Button.clicked()]:\r\n\t//
    Manual Override in effect, do nothing.\r\n\t\r\n\tcase: [$OnClickEvent is $doorButton[doorNumber].clicked()]:\r\n\t//
    lock or unlock door\r\n\t$doorController.action($OnClickEvent.getDoor().locked
    ? true : false);\u200B"
  m_isRightToLeft: 0
